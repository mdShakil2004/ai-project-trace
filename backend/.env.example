PORT=8787
DATABASE_URL=postgresql://...
DB_POOL_MAX=10
OPENROUTER_API_KEY=...
OPENROUTER_MODEL=...
OPENROUTER_EMBEDDING_MODEL=...
AI_MAX_CONTEXT_CHARS=180000

# GitHub OAuth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: this must decode to exactly 32 bytes. Do not use the literal placeholder text.
GITHUB_TOKEN_ENCRYPTION_KEY=GENERATE_A_REAL_32_BYTE_BASE64_KEY

# Local URLs
CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_URL=http://localhost:8787
NODE_ENV=development

# Realtime signing secret; generate a random value for local use.
REALTIME_SECRET=GENERATE_A_RANDOM_SECRET
